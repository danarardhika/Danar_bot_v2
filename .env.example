# Bot Configuration
TELEGRAM_TOKEN=your_bot_token_here
CHANNEL_ID=optional_channel_id

# Environment: production atau development
# Untuk Railway, gunakan polling (bukan webhook)
ENVIRONMENT=development
PORT=8080

# Watchlist (pisahkan dengan koma)
WATCHLIST=BBCA,BBRI,BMRI,TLKM,ASII,UNVR,GOTO,BUMI,ADRO,ANTM,INCO,HRUM

# Threshold
VOLUME_THRESHOLD=1.5

# Cache duration in minutes
CACHE_DURATION_MINUTES=5

# Railway URL (opsional, tidak digunakan jika pakai polling)
RAILWAY_URL=https://your-app-name.railway.app
