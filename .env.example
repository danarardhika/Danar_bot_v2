# Bot Configuration
TELEGRAM_TOKEN=your_bot_token_here
CHANNEL_ID=optional_channel_id

# Environment: production atau development
ENVIRONMENT=development
PORT=8080

# Watchlist (pisahkan dengan koma)
WATCHLIST=BBCA,BBRI,BMRI,TLKM,ASII,UNVR,GOTO

# Threshold
VOLUME_THRESHOLD=1.5

# Cache duration in minutes (default: 5)
CACHE_DURATION_MINUTES=5
